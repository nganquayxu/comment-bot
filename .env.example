# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Display names used in Slack and in the drafts (use quotes if the name has spaces) ---
ACCOUNT_NAME=Brand
ACCOUNT_NAME_PERSONAL=Expert

# --- Meta (Instagram + Facebook) ---
# Brand/company account
# Page access token of the Facebook Page linked to the Instagram account
META_PAGE_TOKEN=
# Facebook Page ID
META_PAGE_ID=
# Instagram Business/Creator account ID
IG_USER_ID=

# Personal/expert account. Leave empty to skip this account.
META_TOKEN_PERSONAL=
META_PAGE_ID_PERSONAL=
IG_USER_ID_PERSONAL=

# --- Slack ---
# Bot User OAuth Token (xoxb-...), scopes: chat:write, channels:history (groups:history for private channels)
SLACK_BOT_TOKEN=
# e.g. C0123456789 (channel name > View channel details > bottom of the dialog)
SLACK_CHANNEL_ID=

# --- Optional ---
# How far back `fetch` looks for comments (hours)
# LOOKBACK_HOURS=24
# Seconds between comments when posting to Slack
# SLACK_PAUSE=4
